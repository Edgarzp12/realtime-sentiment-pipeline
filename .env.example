# Hugging Face model for sentiment classification
# nlptown/bert-base-multilingual-uncased-sentiment outputs 5 classes (1-5 stars)
HF_MODEL=nlptown/bert-base-multilingual-uncased-sentiment

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sentiment_db
MONGO_COLLECTION=raw_comments

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=sentiment

# How many unprocessed comments to pull per pipeline run
LIMIT=200
